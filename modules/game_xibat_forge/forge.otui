XibatForgeCost < Item
  size: 34 34
  draggable: false
  virtual: true
  margin-right: 4
  margin-bottom: 4

XibatForgeBranchCard < Panel
  width: 208
  height: 250
  margin-right: 6
  background-color: #10181dcc
  border-width: 1
  border-color: #3d5363

  Label
    id: status
    anchors.right: parent.right
    anchors.top: parent.top
    margin-right: 9
    margin-top: 8
    color: #79c99e
    font: verdana-11px-rounded
    text-auto-resize: true

  Item
    id: preview
    size: 46 46
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 10
    margin-top: 10
    draggable: false
    virtual: true

  Label
    id: name
    anchors.left: preview.right
    anchors.right: parent.right
    anchors.top: status.bottom
    margin-left: 9
    margin-right: 8
    margin-top: 3
    font: verdana-11px-rounded
    color: #eef3f5
    text-align: left
    text-wrap: true
    height: 28

  Label
    id: level
    anchors.left: parent.left
    anchors.top: preview.bottom
    margin-left: 10
    margin-top: 7
    color: #aebbc5
    text-auto-resize: true

  ProgressBar
    id: progress
    height: 10
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: level.bottom
    margin-left: 10
    margin-right: 10
    margin-top: 5
    background-color: #617782

  Label
    id: description
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: progress.bottom
    margin-left: 10
    margin-right: 10
    margin-top: 9
    height: 48
    color: #c4ccd1
    text-wrap: true
    text-align: top-left

  Label
    id: costsTitle
    anchors.left: parent.left
    anchors.top: description.bottom
    margin-left: 10
    margin-top: 4
    !text: tr('NEXT COST')
    color: #71828c
    text-auto-resize: true

  Panel
    id: costs
    height: 40
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: costsTitle.bottom
    margin-left: 10
    margin-right: 10
    margin-top: 4
    layout:
      type: grid
      cell-size: 38 38
      num-columns: 4
      flow: true

  Button
    id: upgradeButton
    height: 27
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 10
    margin-right: 10
    margin-bottom: 9
    !text: tr('Upgrade')

MainWindow
  id: xibatForge
  !text: tr('Turret Rune Forge')
  size: 700 430
  @onEscape: xibatForgeController:close()

  Item
    id: preview
    size: 64 64
    anchors.left: parent.left
    anchors.top: parent.top
    draggable: false
    virtual: true

  Label
    id: name
    anchors.left: preview.right
    anchors.top: parent.top
    margin-left: 14
    font: verdana-11px-rounded
    color: #eef3f5
    text-auto-resize: true

  Label
    id: branchSummary
    anchors.left: name.left
    anchors.top: name.bottom
    margin-top: 9
    color: #f4d08a
    text-auto-resize: true

  Label
    id: levelSummary
    anchors.left: branchSummary.left
    anchors.top: branchSummary.bottom
    margin-top: 5
    color: #9da9b0
    text-auto-resize: true

  HorizontalSeparator
    id: headerSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: preview.bottom
    margin-top: 10

  Panel
    id: branches
    height: 250
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: headerSeparator.bottom
    margin-top: 10
    layout:
      type: horizontalBox
      fit-children: false

  Label
    id: statusMessage
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: branches.bottom
    margin-top: 9
    color: #9da9b0
    text-align: center
    text-auto-resize: true

  Button
    id: closeButton
    size: 100 26
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    !text: tr('Close')
    @onClick: xibatForgeController:close()

  Button
    id: resetButton
    size: 160 26
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    !text: tr('Reset Upgrades')
