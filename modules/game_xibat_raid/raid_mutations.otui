XibatMutationChoice < CheckBox
  height: 24
  font: verdana-11px-rounded
  margin-bottom: 4
  image-rect: 0 6 12 12
  text-offset: 18 0
  text-align: left

XibatMutationLine < Label
  height: 20
  text-wrap: true
  text-vertical-auto-resize: true
  text-align: left
  color: #c4ccd1
  margin-bottom: 8

XibatMutationAction < Button
  height: 24
  font: verdana-11px-rounded
  text-align: center
  text-offset: 0 0
  padding: 0

XibatMutationSection < Label
  height: 24
  margin-top: 4
  margin-bottom: 4
  font: Verdana Bold-11px
  color: #f4d08a
  background-color: #202c33
  text-offset: 8 0
  text-align: left

XibatMutationStat < Panel
  height: 28
  margin-bottom: 3
  background-color: #182126

  UIWidget
    id: icon
    size: 14 14
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 7
    image-smooth: true
    phantom: true

  Label
    id: caption
    anchors.left: icon.right
    anchors.right: value.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 7
    color: #c4ccd1
    text-align: left

  Label
    id: value
    width: 100
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-right: 8
    text-align: right
    font: Verdana Bold-11px
    color: #f0bf83

XibatMutationLoot < XibatMutationStat
  height: 36

  UIItem
    id: item
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    virtual: true
    phantom: true

  Label
    id: caption
    anchors.left: item.right
    anchors.right: value.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 7
    text-align: left
    text-offset: 0 0
    color: #c4ccd1

MainWindow
  id: xibatRaidMutations
  size: 680 448
  !text: tr('Raid mutations')
  @onEscape: raidSelectorController:closeMutations()

  Label
    id: heading
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 22
    color: #f4d08a

  Label
    id: notice
    anchors.top: heading.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    text-wrap: true
    color: #aebbc5

  ScrollablePanel
    id: choices
    anchors.top: notice.bottom
    anchors.left: parent.left
    anchors.bottom: normalButton.top
    width: 220
    margin-bottom: 10
    vertical-scrollbar: choicesScroll
    layout:
      type: verticalBox
      fit-children: false

  VerticalScrollBar
    id: choicesScroll
    anchors.top: choices.top
    anchors.left: choices.right
    anchors.bottom: choices.bottom
    pixels-scroll: true
    step: 40

  ScrollablePanel
    id: summary
    anchors.top: choices.top
    anchors.left: choicesScroll.right
    anchors.right: summaryScroll.left
    anchors.bottom: choices.bottom
    margin-left: 15
    margin-right: 5
    vertical-scrollbar: summaryScroll
    layout:
      type: verticalBox
      fit-children: false

  VerticalScrollBar
    id: summaryScroll
    anchors.top: choices.top
    anchors.right: parent.right
    anchors.bottom: choices.bottom
    pixels-scroll: true
    step: 40

  XibatMutationAction
    id: normalButton
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 0
    width: 130
    !text: tr('Clear mutations')

  XibatMutationAction
    id: deployButton
    font: Verdana Bold-11px
    color: #fff2cc
    anchors.bottom: normalButton.bottom
    anchors.right: parent.right
    width: 145
    !text: tr('Review selection')

  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: -29
    size: 16 16
    image-source: /images/ui/miniwindow_buttons
    image-clip: 28 0 14 14
    tooltip: Close

    $hover:
      image-clip: 28 14 14 14

    $pressed:
      image-clip: 28 28 14 14
