XibatMutationChoice < CheckBox
  height: 24
  font: verdana-11px-rounded
  margin-bottom: 4
  image-rect: 0 6 12 12
  text-offset: 18 0
  text-align: left

XibatMutationLine < Label
  height: 20
  text-wrap: true
  text-vertical-auto-resize: true
  text-align: left
  color: #c4ccd1
  margin-bottom: 8

XibatMutationAction < Button
  height: 24
  font: verdana-11px-rounded
  text-align: center
  text-offset: 0 0
  padding: 0

MainWindow
  id: xibatRaidMutations
  size: 680 480
  !text: tr('Raid mutations')
  @onEscape: raidSelectorController:closeMutations()

  Label
    id: heading
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 22
    color: #f4d08a

  Label
    id: notice
    anchors.top: heading.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    text-wrap: true
    color: #aebbc5

  ScrollablePanel
    id: choices
    anchors.top: notice.bottom
    anchors.left: parent.left
    anchors.bottom: normalButton.top
    width: 220
    margin-bottom: 10
    vertical-scrollbar: choicesScroll
    layout:
      type: verticalBox
      fit-children: false

  VerticalScrollBar
    id: choicesScroll
    anchors.top: choices.top
    anchors.left: choices.right
    anchors.bottom: choices.bottom
    pixels-scroll: true
    step: 40

  ScrollablePanel
    id: summary
    anchors.top: choices.top
    anchors.left: choicesScroll.right
    anchors.right: summaryScroll.left
    anchors.bottom: choices.bottom
    margin-left: 15
    margin-right: 5
    vertical-scrollbar: summaryScroll
    layout:
      type: verticalBox
      fit-children: false

  VerticalScrollBar
    id: summaryScroll
    anchors.top: choices.top
    anchors.right: parent.right
    anchors.bottom: choices.bottom
    pixels-scroll: true
    step: 40

  XibatMutationAction
    id: normalButton
    anchors.bottom: closeButton.top
    anchors.left: parent.left
    margin-bottom: 8
    width: 130
    !text: tr('Clear mutations')

  XibatMutationAction
    id: deployButton
    anchors.bottom: normalButton.bottom
    anchors.right: parent.right
    width: 145
    !text: tr('Review selection')

  XibatMutationAction
    id: closeButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 90
    !text: tr('Close')
