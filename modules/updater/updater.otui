StaticMainWindow
  id: updaterWindow
  !text: tr('Updater')
  width: 350

  layout:
    type: verticalBox
    fit-children: true
      
  Label
    id: status
    !text: tr('Checking for updates')
    text-align: center

  ProgressBar
    id: mainProgress
    height: 15
    background-color: #4444ff
    margin-bottom: 5
    margin-top: 5

  Label
    id: downloadStatus
    text-align: center
    text-auto-resize: true
    text-wrap: true
    visible: false

  ProgressBar
    id: downloadProgress
    height: 15
    background-color: #4444ff
    margin-bottom: 5
    margin-top: 5
    visible: false
          
  Button
    id: updateNowButton
    margin-left: 50
    margin-right: 50
    margin-top: 5
    !text: tr('Update now')
    @onClick: Updater.install()
    visible: false

  Button
    id: exitButton
    margin-left: 50
    margin-right: 50
    margin-top: 5
    !text: tr('Exit')
    @onClick: Updater.exit()
    visible: false

  Button
    id: cancelButton
    margin-left: 90
    margin-right: 90
    margin-top: 5
    margin-bottom: 10
    !text: tr('Cancel')
    @onClick: Updater.abort()
