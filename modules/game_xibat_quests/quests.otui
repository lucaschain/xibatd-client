XibatQuestCard < Panel
  height: 92
  margin-bottom: 8
  background-color: #121b20cc
  border-width: 1
  border-color: #354852
  padding: 9

  Label
    id: title
    text: First Watch
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: status.left
    font: verdana-11px-rounded
    color: #eadfbf

  Label
    id: status
    text: IN PROGRESS
    anchors.top: parent.top
    anchors.right: parent.right
    text-align: right
    color: #8fa6af

  Label
    id: objective
    text: Collect your first turret rune from Nicolai.
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 7
    height: 30
    text-wrap: true
    color: #c8d1d3

  ProgressBar
    id: progress
    anchors.left: parent.left
    anchors.right: progressText.left
    anchors.bottom: parent.bottom
    margin-right: 8
    height: 8
    text: ""
    value: 33

  Label
    id: progressText
    text: 1 / 3
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 72
    text-align: right
    color: #91a7b2

XibatQuestTracker < UIWindow
  id: xibatQuestTracker
  size: 292 92
  phantom: false
  focusable: false
  draggable: true
  background-color: #10171de6
  border-width: 1
  border-color: #60727a
  padding: 10

  Label
    id: title
    text: First Watch
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: status.left
    font: verdana-11px-rounded
    color: #fff0b8
    phantom: true

  Label
    id: status
    anchors.top: parent.top
    anchors.right: closeButton.left
    margin-right: 7
    text: ACTIVE
    color: #7fc5a0
    phantom: true

  Label
    id: objective
    text: Collect your first turret rune from Nicolai.
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 7
    height: 32
    text-wrap: true
    color: #d2dcde
    phantom: true

  ProgressBar
    id: progress
    anchors.left: parent.left
    anchors.right: progressText.left
    anchors.bottom: parent.bottom
    margin-right: 8
    height: 7
    text: ""
    value: 33
    phantom: true

  Label
    id: progressText
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 72
    text-align: right
    color: #a8bbc2
    text: 1 / 3
    phantom: true

  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    size: 12 12
    image-size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 28 0 14 14

    $hover:
      image-clip: 28 14 14 14

    $pressed:
      image-clip: 28 28 14 14

MainWindow
  id: xibatQuestJournal
  size: 560 520
  text: Quest Journal
  image-source: /images/ui/window
  @onEscape: xibatQuestController:close()

  Label
    id: heading
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 12 16 0 16
    text: ADVENTURE LOG
    font: verdana-11px-rounded
    color: #d8c58f

  Label
    id: summary
    anchors.top: heading.bottom
    anchors.left: heading.left
    anchors.right: heading.right
    margin-top: 4
    color: #91a7b2
    text: 2 quests  |  1 completed

  ScrollablePanel
    id: questList
    anchors.top: summary.bottom
    anchors.left: heading.left
    anchors.right: questScroll.left
    anchors.bottom: parent.bottom
    margin-top: 12
    margin-bottom: 16
    margin-right: 4
    vertical-scrollbar: questScroll
    layout:
      type: verticalBox
      fit-children: false

    XibatQuestCard
      id: previewQuest

  VerticalScrollBar
    id: questScroll
    anchors.top: summary.bottom
    anchors.bottom: parent.bottom
    anchors.right: heading.right
    margin-top: 12
    margin-bottom: 16
    step: 72

  Label
    id: emptyState
    anchors.horizontalCenter: questList.horizontalCenter
    anchors.verticalCenter: questList.verticalCenter
    text: No quests are active yet.
    color: #75878e
    visible: false

  XibatQuestTracker
    id: previewTracker
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
