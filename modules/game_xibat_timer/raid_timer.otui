UIWindow
  id: xibatRaidTimer
  size: 184 58
  anchors.top: parent.top
  anchors.horizontalCenter: parent.horizontalCenter
  margin-top: 74
  background-color: #101820e8
  border-width: 1
  border-color: #3d5363
  focusable: false
  phantom: false
  draggable: true
  visible: true

  UIWidget
    id: accent
    width: 4
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    background-color: #e6a84a
    phantom: true

  Label
    id: title
    anchors.left: accent.right
    anchors.right: closeButton.left
    anchors.top: parent.top
    margin-left: 12
    margin-right: 10
    margin-top: 7
    font: verdana-11px-rounded
    color: #aebbc5
    text-align: center
    text-auto-resize: true
    phantom: true
    text: WAVE STARTS IN

  Label
    id: clock
    anchors.left: accent.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 12
    margin-right: 10
    margin-bottom: 6
    font: verdana-11px-rounded
    color: #f4d08a
    text: 01:24
    text-align: center
    text-auto-resize: true
    phantom: true

  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 5
    margin-right: 5
    size: 12 12
    image-size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 28 0 14 14

    $hover:
      image-clip: 28 14 14 14

    $pressed:
      image-clip: 28 28 14 14
