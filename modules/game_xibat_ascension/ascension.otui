AscensionCategoryButton < Button
  height: 30
  margin-bottom: 3
  text-align: left
  text-offset: 12 0
  font: verdana-11px-rounded

  $pressed:
    text-offset: 11 1

  $on:
    text-offset: 11 1

  $checked:
    text-offset: 11 1

AscensionNodeCard < Panel
  size: 136 200
  background-color: #182126
  border-width: 1
  border-color: #40515a
  padding: 6

  UIItem
    id: item
    size: 48 48
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    virtual: true
    phantom: true
    visible: false

  UIWidget
    id: icon
    size: 48 48
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    image-smooth: true
    image-source: /game_xibat_ascension/images/passives/crystal_elemental_resist

  Label
    id: name
    anchors.top: item.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    height: 48
    text-align: center
    text-wrap: true
    color: #e9dec1
    font: verdana-11px-rounded
    text: Crystal elemental resist +7%

  Label
    id: requirement
    anchors.top: name.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    text-align: center
    color: #91a7b2
    text: Raid level 15

  Label
    id: status
    anchors.top: requirement.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    height: 28
    text-align: center
    text-wrap: true
    font: verdana-11px-rounded
    text: |-
      3 points
      required

  Button
    id: spend
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 25
    text: Spend 2

MainWindow
  id: ascensionWindow
  size: 970 610
  text: Ascension
  image-source: /images/ui/window
  @onEscape: xibatAscensionController:close()

  Label
    id: level
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 8
    margin-left: 16
    font: verdana-11px-rounded
    color: #e4b95e
    text: Ascension Level 12

  Label
    id: points
    anchors.top: level.bottom
    anchors.left: level.left
    margin-top: 3
    color: #c8d5d9
    text: 4 points available | 18 invested

  ProgressBar
    id: experience
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12
    margin-left: 220
    margin-right: 22
    height: 18
    text-offset: 0 -2
    text: 1,240 / 2,000 experience
    value: 62

  Panel
    id: categoryRail
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-top: 64
    margin-bottom: 48
    margin-left: 14
    width: 190
    layout:
      type: verticalBox
      fit-children: false

    AscensionCategoryButton
      id: previewAscensionCrystal
      text: Crystal Defense

    AscensionCategoryButton
      id: previewAscensionTurrets
      text: Turret Damage

    AscensionCategoryButton
      id: previewAscensionUtility
      text: Utility

  VerticalSeparator
    anchors.top: categoryRail.top
    anchors.bottom: categoryRail.bottom
    anchors.left: categoryRail.right
    margin-left: 8

  Label
    id: categoryTitle
    anchors.top: categoryRail.top
    anchors.left: categoryRail.right
    anchors.right: parent.right
    margin-left: 22
    margin-right: 18
    font: verdana-11px-rounded
    color: #e4b95e
    text: Crystal Defense

  Label
    id: categoryProgress
    anchors.top: categoryTitle.bottom
    anchors.left: categoryTitle.left
    anchors.right: categoryTitle.right
    margin-top: 4
    color: #91a7b2
    text: 3 / 30 points invested

  Panel
    id: nodes
    anchors.top: categoryProgress.bottom
    anchors.left: categoryTitle.left
    anchors.right: categoryTitle.right
    anchors.bottom: parent.bottom
    margin-top: 12
    margin-bottom: 52
    layout:
      type: grid
      cell-size: 136 200
      cell-spacing: 8
      num-columns: 5

    AscensionNodeCard
      id: previewAscensionResist

    AscensionNodeCard
      id: previewAscensionRevive
      @onSetup: self:getChildById('icon'):hide()

      UIItem
        id: previewAscensionReviveItem
        size: 48 48
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        virtual: true
        item-id: 3061

  Label
    id: message
    anchors.right: reset.left
    anchors.bottom: parent.bottom
    margin-right: 8
    height: 20
    text-align: right
    text-auto-resize: true
    color: #d5c9a9
    text: Milestones unlock in order. Rewards apply automatically.

  Button
    id: reset
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 120
    text: Reset Points
